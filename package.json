    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.51",
    "@tanstack/router-plugin": "1.168.37",
    "awilix": "13.0.5",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "i18next": "26.4.2",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
